        "required": true
      },
      {
        "id": "novelty",
        "question": "기존 가설과 다른 검증 축이 명시됐는가",
        "required": true
      }
    ],
    "anchors": {
      "0": "근거와 충돌하거나 기준을 충족하지 않음",
      "1": "부분 근거 있으나 검증 조건 부족",
      "2": "참조 가능한 근거와 검증 조건이 명시됨",
      "null": "미확인"
    },
    "minimum_each": 2,
    "gates": [
      "evidence_referenced",
      "no_unsupported_claims"
    ],
    "not_a_reward": true
  },
